{
  "name": "shipcheck",
  "version": "0.1.0",
  "description": "CI gate for env drift, dummy secrets, and OpenAPI/README route drift.",
  "type": "module",
  "bin": {
    "shipcheck": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npx tsx src/cli.ts",
    "shipcheck": "npx tsx src/cli.ts",
    "test": "npx tsx --test test/env.test.ts test/routes.test.ts test/report.test.ts test/config.test.ts",
    "test:bad": "npx tsx src/cli.ts --root fixtures/bad-app",
    "test:good": "npx tsx src/cli.ts --root fixtures/good-app"
  },
  "keywords": [
    "ci",
    "openapi",
    "dotenv",
    "secrets",
    "lint"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
